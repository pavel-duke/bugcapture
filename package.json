{
  "name": "bugcapture",
  "version": "0.2.0",
  "private": true,
  "description": "Локальное расширение для записи браузерных ошибок и безопасного сбора диагностики",
  "type": "module",
  "scripts": {
    "sync-version": "node scripts/sync-version.mjs",
    "predev": "npm run sync-version",
    "dev": "vite",
    "clean": "node scripts/clean.mjs",
    "prebuild": "npm run sync-version && npm run clean",
    "build": "vite build",
    "package": "npm run build && node scripts/package.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run package",
    "demo": "node scripts/demo-server.mjs",
    "screenshot": "npm run build && node scripts/capture-popup.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/archiver": "8.0.0",
    "@types/chrome": "0.2.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "archiver": "8.0.0",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "jsdom": "30.0.1",
    "playwright-core": "1.62.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
